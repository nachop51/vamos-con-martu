	carriage: `<circle cx="12" cy="10.5" r="5.5"/><path d="M12 5v11M7.5 8h9M7.5 13h9"/><circle cx="8" cy="19" r="1.8"/><circle cx="16" cy="19" r="1.8"/>`,
	suitcase: `<rect x="4" y="8" width="16" height="12" rx="2.5"/><path d="M9 8V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V8M9 12v4M15 12v4"/>`,
	map: `<path d="M3.5 6.5 9 4.5l6 2 5.5-2v13l-5.5 2-6-2-5.5 2v-13Z"/><path d="M9 4.5v13M15 6.5v13"/>`,
	calendar: `<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/><path d="m10.5 14.5 1.5 1.5 3-3.5"/>`,
