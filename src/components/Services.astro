---
import Reveal from './Reveal.astro';
import Icon from './Icon.astro';
import NightSparkles from './NightSparkles.astro';
import { SITE, WA_MESSAGES, waLink } from '../config';
---

<section id="servicios" class="sky-servicios relative -mt-px scroll-mt-20 pt-12 pb-20 md:pt-14 md:pb-24">
	<NightSparkles seed={3} />
	<div class="relative mx-auto max-w-6xl px-5">
		<Reveal>
			<p class="font-display mb-3 text-sm tracking-[0.25em] text-destello uppercase">Servicios</p>
			<h2 class="font-display max-w-2xl text-balance text-4xl font-semibold text-nube md:text-5xl">
				Dos maneras de llegar a la magia
			</h2>
		</Reveal>

		<div class="mt-12 grid gap-6 md:grid-cols-5">
			<!-- Featured: salida grupal -->
			<Reveal class="md:col-span-3">
				<article class="card card-featured flex h-full flex-col rounded-3xl p-8 md:p-10">
					<Icon name="suitcase" size={34} class="text-destello" />
					<h3 class="font-display mt-5 text-3xl font-semibold text-nube">Salida grupal</h3>
					<div class="mt-4 grow">
						<p class="text-lg leading-relaxed text-lila">
							Viajamos juntos a Orlando en grupos reducidos, flexibles y personalizados. Me
							encargo de organizar la experiencia: horarios, traslados, entradas y todos los
							detalles para que solo tengas que vivir la magia. Compartimos una experiencia
							pensada para disfrutar al máximo los parques, sin dejar de lado el tiempo para
							descansar, recorrer, hacer compras y vivir cada viaje a su propio ritmo.
						</p>
						<p class="mt-3 leading-relaxed text-lila/80">
							Contamos con el respaldo de Jetmar para la gestión operativa del viaje,
							incluyendo vuelos, hoteles y tickets.
						</p>
					</div>
					<ul class="mt-6 space-y-2.5 text-lila">
						<li class="flex items-center gap-2.5">
							<Icon name="star" size={15} class="shrink-0 text-rosa" /> Itinerario planificado de principio a fin
						</li>
						<li class="flex items-center gap-2.5">
							<Icon name="star" size={15} class="shrink-0 text-rosa" /> Grupos reducidos y flexibles
						</li>
						<li class="flex items-center gap-2.5">
							<Icon name="star" size={15} class="shrink-0 text-rosa" /> Sorpresas y momentos especiales
						</li>
						<li class="flex items-center gap-2.5">
							<Icon name="star" size={15} class="shrink-0 text-rosa" /> Viaje apoyado por Jetmar
						</li>
					</ul>
				</article>
			</Reveal>

			<!-- Secondary: viaje personalizado -->
			<Reveal delay={150} class="md:col-span-2">
				<article class="card flex h-full flex-col rounded-3xl p-8">
					<Icon name="map" size={30} class="text-lila" />
					<h3 class="font-display mt-5 text-2xl font-semibold text-nube">
						Itinerario personalizado
					</h3>
					<p class="mt-4 grow leading-relaxed text-lila">
						¿Ya tenés el viaje? Te ayudo a planificarlo. Armamos un itinerario personalizado
						con recomendaciones de parques, restaurantes, atracciones y recorridos para
						aprovechar cada día al máximo.
					</p>
					<a
						href={waLink(WA_MESSAGES.personalizado)}
						target="_blank"
						rel="noopener"
						class="btn-ghost mt-8 self-start text-sm"
					>
						Quiero mi itinerario
						<Icon name="arrow" size={15} />
					</a>
				</article>
			</Reveal>
		</div>

		<Reveal delay={250}>
			<div
				class="next-departure mt-6 flex flex-wrap items-center justify-between gap-x-8 gap-y-5 rounded-3xl p-6 md:p-8"
			>
				<div>
					<div class="flex items-center gap-2.5">
						<Icon name="calendar" size={17} class="shrink-0 text-destello" />
						<p class="font-display text-xs tracking-[0.25em] text-destello uppercase">
							Próxima salida
						</p>
					</div>
					<p class="font-display mt-1.5 text-3xl font-semibold text-nube">
						{SITE.nextDeparture}
					</p>
				</div>
				<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
					<a
						href={waLink(WA_MESSAGES.grupal)}
						target="_blank"
						rel="noopener"
						class="btn-magic"
					>
						<Icon name="whatsapp" size={18} />
						Quiero ir
					</a>
					<a
						href={waLink(WA_MESSAGES.siguientes)}
						target="_blank"
						rel="noopener"
						class="btn-ghost text-sm"
					>
						Consultá por siguientes salidas
						<Icon name="arrow" size={15} />
					</a>
				</div>
			</div>
		</Reveal>
	</div>
</section>

<style>
	.card {
		background: rgb(255 255 255 / 0.05);
		border: 1px solid rgb(169 214 229 / 0.25);
		backdrop-filter: blur(4px);
		transition:
			transform 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: rgb(234 217 76 / 0.5);
		box-shadow: 0 12px 40px rgb(37 24 49 / 0.5);
	}

	.card-featured {
		background: linear-gradient(150deg, rgb(255 55 166 / 0.14), rgb(255 32 153 / 0.08) 55%, rgb(255 255 255 / 0.04));
		border-color: rgb(255 55 166 / 0.35);
	}

	.card-featured:hover {
		border-color: rgb(255 55 166 / 0.6);
	}

	.next-departure {
		background: rgb(234 217 76 / 0.07);
		border: 1px solid rgb(234 217 76 / 0.3);
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.card:hover {
			transform: none;
		}
	}
</style>
