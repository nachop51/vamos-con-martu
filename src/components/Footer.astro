---
import Icon from './Icon.astro';
import { SITE, WA_MESSAGES, waLink } from '../config';

const year = new Date().getFullYear();

const navLinks = [
	{ href: '#sobre-mi', label: 'Sobre mí' },
	{ href: '#servicios', label: 'Servicios' },
	{ href: '#como-funciona', label: 'Cómo funciona' },
	{ href: '#preguntas', label: 'Preguntas frecuentes' },
	{ href: '#contacto', label: 'Contacto' },
];

const stars = Array.from({ length: 14 }, (_, i) => ({
	left: `${(2 + i * 7 + Math.random() * 5).toFixed(1)}%`,
	top: `${(8 + Math.random() * 80).toFixed(1)}%`,
	size: Math.random() < 0.7 ? 2 : 3,
	delay: (Math.random() * 4).toFixed(1),
	dur: (2.5 + Math.random() * 3).toFixed(1),
}));

// same looping fireworks as the hero castle, scaled down to the short
// sunset strip; delays staggered so they never bloom all at once
const fireworks = [
	{ x: 10, y: 16, color: 'var(--color-rosa)', delay: 0.6, scale: 0.7 },
	{ x: 30, y: 6, color: 'var(--color-destello)', delay: 2.1, scale: 0.85 },
	{ x: 56, y: 12, color: 'var(--color-lila)', delay: 3.8, scale: 0.6 },
	{ x: 74, y: 5, color: 'var(--color-rosa)', delay: 5.2, scale: 0.8 },
	{ x: 91, y: 15, color: 'var(--color-destello)', delay: 6.9, scale: 0.65 },
];
const FW_PARTICLES = 12;

---

<footer class="footer relative -mt-px">
	<!-- sunset horizon: the pink day fades behind the castle one last time.
	     Not aria-hidden as a whole: it also holds the (real, focusable) button
	     that fires the rockets, so each decorative layer hides itself. -->
	<div class="sunset relative overflow-hidden">
		<!-- fireworks bloom in the sky, partly hidden behind the skyline -->
		<div class="fw-layer" aria-hidden="true">
			{
				fireworks.map((f) => (
					<span
						class="firework"
						style={`left:${f.x}%;top:${f.y}%;--fw-color:${f.color};--fw-scale:${f.scale};animation-delay:${f.delay}s;`}
					>
						{Array.from({ length: FW_PARTICLES }, (_, i) => (
							<i style={`transform:rotate(${(360 / FW_PARTICLES) * i}deg)`} />
						))}
					</span>
				))
			}
		</div>
		<!-- rockets + click bursts land here, behind the silhouette -->
		<div class="rocket-layer absolute inset-0" aria-hidden="true"></div>
		<svg class="skyline" aria-hidden="true" viewBox="0 0 1200 240" preserveAspectRatio="xMidYMax meet" fill="none">
			<defs>
				<radialGradient id="sunset-sun" cx="50%" cy="50%" r="50%">
					<stop offset="0%" stop-color="#F6EFA6" stop-opacity="0.95" />
					<stop offset="34%" stop-color="#EAD94C" stop-opacity="0.75" />
					<stop offset="62%" stop-color="#FF7FC5" stop-opacity="0.3" />
					<stop offset="100%" stop-color="#FF7FC5" stop-opacity="0" />
				</radialGradient>
			</defs>

			<!-- the sun sinking between the sphere and the castle -->
			<circle cx="500" cy="205" r="160" fill="url(#sunset-sun)" />
			<circle cx="500" cy="205" r="54" fill="#F6EFA6" opacity="0.9" />

			<!-- the park at closing time: coaster mountain, geodesic sphere, the
			     castle everyone says goodnight to, monorail heading home, and a
			     princess turret watching from the hill -->
			<g fill="#31203C" stroke-linecap="round">
				<!-- ground -->
				<path
					d="M0 240v-34c150-18 300-24 450-18s300 22 450 20 220-14 300-6v38H0Z"
				/>
				<!-- giant ferris wheel, slowly turning the evening away -->
				<path d="M150 130 114 228h10l26-70 26 70h10Z" />
				<g class="ferris">
					<circle cx="150" cy="130" r="78" stroke="#31203C" stroke-width="5" fill="none" />
					<path
						d="M150 130h78M150 130h-78M150 130v78M150 130v-78M150 130l55 55M150 130l-55 55M150 130l55-55M150 130l-55-55"
						stroke="#31203C"
						stroke-width="3"
					/>
					<circle cx="228" cy="130" r="5" />
					<circle cx="205" cy="185" r="5" />
					<circle cx="150" cy="208" r="5" />
					<circle cx="95" cy="185" r="5" />
					<circle cx="72" cy="130" r="5" />
					<circle cx="95" cy="75" r="5" />
					<circle cx="150" cy="52" r="5" />
					<circle cx="205" cy="75" r="5" />
				</g>
				<circle cx="150" cy="130" r="7" />
				<!-- pines -->
				<path d="M265 210l22-52 22 52Zm48 8 18-40 18 40Z" />
				<!-- geodesic sphere resting on the treeline -->
				<circle cx="400" cy="168" r="46" />
				<!-- the castle: keep, spire, four towers, flags flying -->
				<path d="M480 240v-50h240v50Z" />
				<path d="M496 240v-90h34v90Z" />
				<path d="M489 152l24-46 24 46Z" />
				<path d="M513 106v-16l10 3.5-10 3.5" stroke="#31203C" stroke-width="2.5" />
				<path d="M540 240v-70h24v70Z" />
				<path d="M535 172l17-32 17 32Z" />
				<path d="M560 240V120h80v120Z" />
				<path d="M552 122l48-70 48 70Z" />
				<path d="M600 52v-20l13 4.5-13 4.5" stroke="#31203C" stroke-width="3" />
				<path d="M636 240v-70h24v70Z" />
				<path d="M631 172l17-32 17 32Z" />
				<path d="M670 240v-90h34v90Z" />
				<path d="M663 152l24-46 24 46Z" />
				<path d="M687 106v-16l10 3.5-10 3.5" stroke="#31203C" stroke-width="2.5" />
				<!-- roller coaster: two humps, lattice supports, a little train
				     easing down the first drop -->
				<path
					d="M732 214Q798 108 862 206Q922 128 982 206Q1018 158 1058 212"
					stroke="#31203C"
					stroke-width="5"
					fill="none"
				/>
				<path
					d="M780 240v-72M800 240v-84M862 240v-30M922 240v-66M944 240v-62M1020 240v-56"
					stroke="#31203C"
					stroke-width="5"
					fill="none"
				/>
				<circle cx="826" cy="158" r="7" />
				<circle cx="842" cy="176" r="7" />
				<circle cx="856" cy="194" r="7" />
				<!-- princess turret with pennant, little sister tower beside it -->
				<path d="M1088 240V128h30v112Z" />
				<path d="M1080 130l23-54 23 54Z" />
				<path d="M1103 76v-18l12 4-12 4" stroke="#31203C" stroke-width="3" />
				<path d="M1130 240v-52h22v52Z" />
				<path d="M1126 190l15-30 15 30Z" />
			</g>
			<!-- lit windows: someone is still home -->
			<g fill="var(--color-destello)">
				<circle class="win" cx="600" cy="150" r="4" style="--tw-min:0.45" />
				<circle class="win" cx="600" cy="192" r="4" style="--tw-min:0.45;animation-delay:2.2s" />
				<circle class="win" cx="513" cy="178" r="3" style="--tw-min:0.4;animation-delay:0.9s" />
				<circle class="win" cx="687" cy="178" r="3" style="--tw-min:0.4;animation-delay:3.1s" />
				<circle class="win" cx="1103" cy="162" r="3.5" style="--tw-min:0.45;animation-delay:1.6s" />
			</g>
			<!-- elevated monorail beam, front of the whole scene -->
			<g fill="#31203C">
				<path d="M0 150h1200" stroke="#31203C" stroke-width="5" />
				{
					[70, 210, 330, 470, 610, 750, 890, 1030, 1170].map((x) => (
						<path d={`M${x} 152l-5 88h14l-5-88Z`} />
					))
				}
			</g>
			<!-- the monorail heading home: glides across on a loop -->
			<g class="monorail">
				<path
					fill="#31203C"
					d="M2 153V138q0-8 8-8h122q18 0 30 9l10 7q6 5 0 7Z"
				/>
				<g fill="var(--color-destello)" opacity="0.85">
					<rect x="14" y="135" width="14" height="7" rx="2" />
					<rect x="38" y="135" width="14" height="7" rx="2" />
					<rect x="62" y="135" width="14" height="7" rx="2" />
					<rect x="86" y="135" width="14" height="7" rx="2" />
					<rect x="110" y="135" width="14" height="7" rx="2" />
					<rect x="140" y="136" width="16" height="8" rx="3" />
				</g>
				<circle cx="171" cy="148" r="2.5" fill="#F6EFA6" opacity="0.9" />
			</g>
		</svg>
		<!-- real, focusable button covering the whole skyline strip -->
		<button
			type="button"
			class="skyline-trigger"
			aria-label="Lanzar fuegos artificiales desde el castillo"></button>
	</div>

	<!-- night content -->
	<div class="night relative overflow-hidden">
		<div class="pointer-events-none absolute inset-0" aria-hidden="true" data-parallax="0.2">
			{
				stars.map((s) => (
					<span
						class="star twinkle absolute rounded-full bg-white"
						style={`left:${s.left};top:${s.top};width:${s.size}px;height:${s.size}px;--tw-min:0.15;animation-delay:${s.delay}s;animation-duration:${s.dur}s`}
					/>
				))
			}
		</div>

		<div class="relative mx-auto grid max-w-6xl gap-12 px-5 pt-14 pb-12 md:grid-cols-[1.4fr_1fr_1fr] md:gap-8">
			<div>
				<p class="font-display flex items-center gap-2.5 text-2xl font-semibold text-nube">
					<Icon name="castle" size={26} class="text-destello" />
					{SITE.brand}
				</p>
				<p class="mt-4 max-w-xs leading-relaxed text-lila">
					Viajes grupales a Disney Orlando, acompañados de principio a fin, para que solo
					te ocupes de disfrutarlos.
				</p>
				<a href={SITE.instagram} target="_blank" rel="noopener" class="ig-link mt-5">
					<Icon name="instagram" size={17} />
					{SITE.instagramHandle}
				</a>
			</div>

			<nav aria-label="Secciones del sitio">
				<p class="font-display text-sm tracking-[0.22em] text-destello uppercase">Secciones</p>
				<ul class="mt-4 space-y-2.5">
					{
						navLinks.map((l) => (
							<li>
								<a href={l.href} class="foot-link">
									{l.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div>
				<p class="font-display text-sm tracking-[0.22em] text-destello uppercase">Escribime</p>
				<ul class="mt-4 space-y-2.5">
					<li>
						<a href={waLink(WA_MESSAGES.general)} target="_blank" rel="noopener" class="foot-link">
							<Icon name="whatsapp" size={17} /> WhatsApp
						</a>
					</li>
					<li>
						<a href={`mailto:${SITE.email}`} class="foot-link">
							<Icon name="mail" size={17} />
							{SITE.email}
						</a>
					</li>
					<li>
						<a href={SITE.instagram} target="_blank" rel="noopener" class="foot-link">
							<Icon name="instagram" size={17} /> Instagram
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="relative border-t border-white/10">
			<div
				class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-5 py-6 text-sm text-lila/70 sm:flex-row"
			>
				<p>© {year} {SITE.brand} · Hecho con magia desde Uruguay ✨</p>
				<a href="#" class="top-link">✦ Volver arriba</a>
			</div>
		</div>
	</div>
</footer>

<style>
	/* dusk sky behind the silhouette — hands off from the contact section's pink */
	.sunset {
		background: linear-gradient(to bottom, #FFCAE9, #FF9FD4 45%, #D06CB9 78%, #8F4E93);
	}

	.skyline {
		display: block;
		margin: 0 auto;
		margin-bottom: -1px;
		width: max(100%, 720px);
		aspect-ratio: 1200 / 240;
		height: auto;
		position: relative;
		left: 50%;
		transform: translateX(-50%);
	}

	.night {
		background: linear-gradient(to bottom, #31203C, var(--color-noche));
	}

	/* fireworks over the sunset — same build as the hero's: 12 rotated arms
	   with a particle dot at the tip, blooming on the global keyframes */
	.fw-layer {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.firework {
		position: absolute;
		width: 4px;
		height: 4px;
		opacity: 0;
		animation: bloom 7.5s ease-out infinite;
	}

	.firework i {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 2px;
		height: 58px;
		transform-origin: top center;
	}

	.firework i::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: -1.5px;
		width: 5px;
		height: 5px;
		border-radius: 999px;
		background: var(--fw-color);
		box-shadow: 0 0 8px var(--fw-color);
	}

	@media (prefers-reduced-motion: reduce) {
		.firework {
			display: none;
		}
	}

	/* invisible hit area over the skyline; the script hides it on reduced motion */
	.skyline-trigger {
		position: absolute;
		inset: 0;
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.skyline-trigger:focus-visible {
		outline: 2px solid var(--color-destello);
		outline-offset: -6px;
		border-radius: 12px;
	}

	.star {
		animation: twinkle 3s ease-in-out infinite;
	}

	/* twinkling silhouette windows — scale from their own center, not the svg's */
	.win {
		animation: twinkle 4s ease-in-out infinite;
		transform-box: fill-box;
		transform-origin: center;
	}

	/* ferris wheel: rim, spokes and gondolas all spin together — the gondolas
	   are plain circles, so orbiting with the wheel still reads correctly */
	.ferris {
		transform-box: view-box;
		transform-origin: 150px 130px;
		animation: ferris-turn 48s linear infinite;
	}

	@keyframes ferris-turn {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ferris {
			animation: none;
		}
	}

	/* the monorail crosses the whole skyline and loops around; the negative
	   delay means it's already mid-scene when the footer scrolls into view */
	.monorail {
		animation: monorail-cross 26s linear infinite;
		animation-delay: -7s;
		will-change: transform;
	}

	@keyframes monorail-cross {
		from {
			transform: translateX(-220px);
		}
		to {
			transform: translateX(1240px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		/* parked over the coaster stretch, where the sky is mostly open */
		.monorail {
			animation: none;
			transform: translateX(920px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.star,
		.win {
			animation: none;
		}
	}

	.foot-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-lila);
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.foot-link:hover {
		color: var(--color-nube);
		transform: translateX(3px);
	}

	.ig-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		color: var(--color-destello);
		transition: color 0.2s ease;
	}

	.ig-link:hover {
		color: var(--color-nube);
	}

	.top-link {
		font-weight: 600;
		color: var(--color-destello);
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.top-link:hover {
		color: var(--color-nube);
		transform: translateY(-2px);
	}

	@media (prefers-reduced-motion: reduce) {
		.foot-link:hover,
		.top-link:hover {
			transform: none;
		}
	}
</style>

<script>
	// clicking the skyline fires a rocket volley, same as the hero castle;
	// smaller bursts because the sunset strip is much shorter than the hero
	import { wireCastleFireworks } from '../scripts/castle-fireworks';

	wireCastleFireworks(
		document.querySelector('.footer .rocket-layer'),
		document.querySelector('.skyline-trigger'),
		{ scale: [0.45, 0.4] },
	);
</script>
