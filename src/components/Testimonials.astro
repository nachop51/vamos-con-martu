---
import Reveal from './Reveal.astro';
import Icon from './Icon.astro';
import { testimonials } from '../data/testimonials';
---

{
	testimonials.length > 0 && (
		<section id="testimonios" class="sky-dia relative -mt-px scroll-mt-20 py-24">
			<div class="mx-auto max-w-6xl px-5">
				<Reveal>
					<p class="font-display mb-3 text-sm tracking-[0.25em] text-magenta uppercase">Testimonios</p>
					<h2 class="font-display max-w-2xl text-balance text-4xl font-semibold text-tinta md:text-5xl">
						Viajeros que ya vivieron la magia
					</h2>
				</Reveal>
				<div class="mt-12 grid gap-6 md:grid-cols-3">
					{testimonials.map((t, i) => (
						<Reveal delay={i * 120}>
							<figure class="quote h-full rounded-3xl bg-white p-7">
								<Icon name="star" size={20} class="text-destello" />
								<blockquote class="mt-4 leading-relaxed text-tinta/85">“{t.quote}”</blockquote>
								<figcaption class="mt-5 text-sm font-semibold text-magenta">
									{t.name} · {t.trip}
								</figcaption>
							</figure>
						</Reveal>
					))}
				</div>
			</div>
		</section>
	)
}

<style>
	.quote {
		border: 1px solid rgb(255 32 153 / 0.15);
		box-shadow: 0 8px 30px rgb(43 45 66 / 0.08);
	}
</style>
