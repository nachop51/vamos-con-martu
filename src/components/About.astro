---
import { Image } from 'astro:assets';
import Reveal from './Reveal.astro';
import Icon from './Icon.astro';
import NightSparkles from './NightSparkles.astro';
import { SITE } from '../config';
import portrait from '../assets/martu/martu.webp';
import martuAndMickey from '../assets/martu/martu-and-mickey.webp';
import martuInCastle from '../assets/martu/martu-in-castle.webp';
import fireworks from '../assets/magic-kingdom/closing-fireworks-2.webp';

const chips = ['🇺🇾 Uruguaya', '🎓 Lic. en Comunicación', '🏰 Fan de Disney de toda la vida'];

const polaroids = [
	{ img: martuAndMickey, caption: 'Con Mickey ✨', rot: '-7deg' },
	{ img: martuInCastle, caption: 'Frente al castillo 🏰', rot: '4deg' },
	{ img: fireworks, caption: 'Fuegos de cierre 🎆', rot: '-3deg' },
];
---

<section id="sobre-mi" class="sky-sobre relative -mt-px scroll-mt-20 pt-24 pb-12 md:pt-32 md:pb-14">
	<NightSparkles seed={1} />
	<div class="relative mx-auto grid max-w-6xl items-center gap-14 px-5 md:grid-cols-2">
		<Reveal>
			<div class="relative mx-auto w-fit pb-16">
				<!-- arch portrait -->
				<div class="portrait relative w-64 overflow-hidden sm:w-72">
					<Image
						src={portrait}
						alt="Martina Paz, Martu, en Disney"
						class="h-full w-full object-cover"
						widths={[320, 640]}
						sizes="(max-width: 640px) 320px, 640px"
					/>
				</div>
				<!-- name plate -->
				<div class="nameplate absolute -bottom-0 left-1/2 w-max -translate-x-1/2 rounded-2xl bg-white px-6 py-3 text-center shadow-xl">
					<p class="font-display text-xl font-semibold text-tinta">Martina Paz</p>
					<p class="text-sm text-tinta/60">Martu · 27 años</p>
				</div>
				<!-- mini polaroids peeking from behind -->
				<div
					class="pointer-events-none absolute -right-24 top-6 hidden h-64 w-40 lg:block"
					data-parallax="-0.08"
				>
					{
						polaroids.map((p, i) => (
							<figure
								class="polaroid pointer-events-auto absolute rounded-md bg-white p-2 pb-7 shadow-2xl"
								style={`--rot:${p.rot}; z-index:${i + 1}; left:${i * 8}px; top:${i * 26}%; animation-delay:${i * 0.7}s`}
								tabindex="0"
								aria-label={`Foto: ${p.caption}`}
							>
								<Image
									src={p.img}
									alt=""
									widths={[96, 192]}
									sizes="96px"
									class="h-24 w-24 rounded-sm object-cover"
								/>
								<figcaption class="mt-1.5 text-center text-[10px] leading-tight text-neutral-600">
									{p.caption}
								</figcaption>
							</figure>
						))
					}
				</div>
			</div>
		</Reveal>

		<div>
			<Reveal>
				<p class="font-display mb-3 text-sm tracking-[0.25em] text-destello uppercase">Sobre mí</p>
				<h2 class="font-display text-balance text-4xl font-semibold text-nube md:text-5xl">
					Hola, soy <span class="text-rosa">Martu</span>
				</h2>
				<ul class="mt-5 flex flex-wrap gap-2">
					{chips.map((c) => <li class="chip">{c}</li>)}
				</ul>
			</Reveal>
			<Reveal delay={120}>
				<p class="mt-6 text-lg leading-relaxed text-lila">
					Fui a Disney varias veces y cada viaje me confirmó lo mismo: la magia es real, pero
					se disfruta más cuando alguien te acompaña a vivirla.
				</p>
			</Reveal>
			<Reveal delay={190}>
				<p class="mt-4 text-lg leading-relaxed text-lila">
					Me enamoran los castillos, las princesas, los fuegos artificiales y todo lo que
					brille (si es rosa, mejor). En mi Instagram comparto rankings, recorridos y todo lo
					que aprendí en los parques.
				</p>
			</Reveal>
			<Reveal delay={260}>
				<p class="mt-4 text-lg leading-relaxed text-lila">
					Ahora quiero ir un paso más allá: viajar con vos y acompañarte para que vivas
					Disney con tranquilidad, organización y cercanía.{' '}
					<strong class="text-nube">Como viajar con un hada madrina, pero real.</strong>
				</p>
			</Reveal>
			<Reveal delay={330}>
				<a
					href={SITE.instagram}
					target="_blank"
					rel="noopener"
					class="mt-7 inline-flex items-center gap-2 font-semibold text-destello transition-colors hover:text-nube"
				>
					<Icon name="instagram" size={18} />
					Seguí mis viajes en {SITE.instagramHandle}
					<Icon name="arrow" size={16} />
				</a>
			</Reveal>
		</div>
	</div>
</section>

<script>
	// Hovering (or focusing, or tapping on touch) brings a polaroid to the top.
	let zTop = 10;
	const bringToFront = (el: HTMLElement) => {
		zTop++;
		el.style.zIndex = String(zTop);
		document.querySelectorAll<HTMLElement>('.polaroid').forEach((p) => p.classList.toggle('is-front', p === el));
	};
	document.querySelectorAll<HTMLElement>('.polaroid').forEach((p) => {
		p.addEventListener('mouseenter', () => bringToFront(p));
		p.addEventListener('focus', () => bringToFront(p));
		p.addEventListener('click', () => bringToFront(p));
	});
</script>

<style>
	.portrait {
		aspect-ratio: 3 / 4;
		border-radius: 999px 999px 28px 28px;
		border: 4px solid rgb(255 255 255 / 0.18);
		box-shadow:
			0 0 0 1px rgb(234 217 76 / 0.25),
			0 24px 70px rgb(0 0 0 / 0.45),
			0 0 60px rgb(255 55 166 / 0.18);
	}

	.nameplate {
		border: 1px solid rgb(255 32 153 / 0.15);
	}

	.chip {
		border-radius: 999px;
		border: 1px solid rgb(169 214 229 / 0.35);
		background: rgb(255 255 255 / 0.06);
		padding: 0.3rem 0.8rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-lila);
	}

	.polaroid {
		transform: rotate(var(--rot));
		animation: float-slow 7s ease-in-out infinite;
		transition:
			transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.6s cubic-bezier(0.22, 1, 0.36, 1),
			z-index 0s linear 0.15s;
		will-change: transform;
	}

	.polaroid.is-front {
		animation: none;
		transform: rotate(calc(var(--rot) * 0.35)) translateY(-6px) scale(1.05);
		box-shadow: 0 20px 45px rgb(0 0 0 / 0.45);
	}

	@media (prefers-reduced-motion: reduce) {
		.polaroid {
			animation: none;
			transition: none;
		}
	}
</style>
