---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/figtree/index.css';
import '../styles/global.css';
import { SITE } from '../config';
import { faq } from '../data/faq';

const KEYWORDS = [
	'viajes a Disney',
	'Disney Orlando',
	'viajes grupales a Disney',
	'viaje a Disney desde Uruguay',
	'salidas grupales Disney',
	'viaje personalizado a Disney',
	'acompañante de viaje a Disney',
	'Walt Disney World',
	'Magic Kingdom',
	'viajes acompañados Orlando',
].join(', ');

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'TravelAgency',
		name: SITE.brand,
		description: SITE.description,
		url: SITE.url,
		image: `${SITE.url}/og.jpg`,
		email: SITE.email,
		sameAs: [SITE.instagram],
		areaServed: { '@type': 'Country', name: 'Uruguay' },
		founder: { '@type': 'Person', name: 'Martina Paz' },
		knowsLanguage: 'es',
		makesOffer: [
			{
				'@type': 'Offer',
				itemOffered: {
					'@type': 'Service',
					name: 'Salida grupal a Disney Orlando',
					description:
						'Viajes grupales reducidos a Disney Orlando con acompañamiento de principio a fin: organización de horarios, traslados y entradas.',
				},
			},
			{
				'@type': 'Offer',
				itemOffered: {
					'@type': 'Service',
					name: 'Viaje personalizado a Disney Orlando',
					description:
						'Diseño de viajes a medida a Disney Orlando: parques, orden, comidas y cotización completa.',
				},
			},
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.map((f) => ({
			'@type': 'Question',
			name: f.question,
			acceptedAnswer: { '@type': 'Answer', text: f.answer },
		})),
	},
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{SITE.title}</title>
		<meta name="description" content={SITE.description} />
		<meta name="keywords" content={KEYWORDS} />
		<meta name="author" content="Martina Paz" />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${SITE.url}/`} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={SITE.title} />
		<meta property="og:description" content={SITE.description} />
		<meta property="og:url" content={`${SITE.url}/`} />
		<meta property="og:locale" content="es_UY" />
		<meta property="og:site_name" content={SITE.brand} />
		<meta property="og:image" content={`${SITE.url}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="2400" />
		<meta property="og:image:height" content="1260" />
		<meta property="og:image:alt" content="Martu en Disney — Disney acompañado, real y sin perder la magia" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={SITE.title} />
		<meta name="twitter:description" content={SITE.description} />
		<meta name="twitter:image" content={`${SITE.url}/og.jpg`} />
		<meta name="twitter:image:alt" content="Martu en Disney — Disney acompañado, real y sin perder la magia" />
		<meta name="theme-color" content="#251831" />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<slot />
		<script>
			// Scroll reveal: one observer for every .reveal element.
			const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const targets = document.querySelectorAll<HTMLElement>('.reveal');
			if (prefersReduced) {
				targets.forEach((el) => el.classList.add('is-visible'));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
				);
				targets.forEach((el) => observer.observe(el));
			}
		</script>
		<script>
			// Scroll parallax: elements with data-parallax="<speed>" drift relative
			// to the viewport center. Positive speed = lags behind the scroll
			// (reads as background depth); negative = races ahead (foreground).
			// Uses the CSS `translate` property so it composes with the existing
			// transform-based animations (twinkle, float-slow, cloud-drift…).
			interface ParallaxItem {
				el: HTMLElement;
				speed: number;
				fade: boolean;
				min: number; // floor for the translate (px, negative = up) — caps how far an element can rise
				y: number;
			}

			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const items: ParallaxItem[] = Array.from(
				document.querySelectorAll<HTMLElement>('[data-parallax]')
			).map((el) => ({
				el,
				speed: parseFloat(el.dataset.parallax || '0') || 0,
				fade: 'parallaxFade' in el.dataset,
				min: el.dataset.parallaxMin ? parseFloat(el.dataset.parallaxMin) : -Infinity,
				y: 0,
			}));

			if (!reduced && items.length) {
				let ticking = false;

				const update = () => {
					ticking = false;
					const mid = window.innerHeight / 2;

					// read pass (all rects first, then all writes — no layout thrash)
					const frames = items.map((it) => {
						const r = it.el.getBoundingClientRect();
						if (!r.width && !r.height) return null; // display:none (e.g. md:hidden)
						// rect includes the current translate; subtract it to get home position
						const center = r.top + r.height / 2 - it.y;
						// rest point is the viewport center — except for elements already
						// visible at scrollY 0 (the hero), whose rest point is page top,
						// so the authored composition is untouched on load
						const anchor = Math.max(0, mid - (center + window.scrollY));
						const offset = mid - center - anchor;
						return {
							y: Math.max(offset * it.speed, it.min),
							// 1 at rest, fading to 0 as the element scrolls out the top
							opacity: it.fade ? Math.min(1, Math.max(0, 1 - offset / (mid * 1.4))) : null,
						};
					});

					// write pass
					items.forEach((it, i) => {
						const f = frames[i];
						if (!f) return;
						it.y = f.y;
						it.el.style.translate = `0 ${f.y.toFixed(1)}px`;
						if (f.opacity !== null) it.el.style.opacity = f.opacity.toFixed(3);
					});
				};

				const schedule = () => {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(update);
					}
				};

				window.addEventListener('scroll', schedule, { passive: true });
				window.addEventListener('resize', schedule, { passive: true });
				update();
			}
		</script>
	</body>
</html>
